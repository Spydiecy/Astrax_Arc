# ── Astrax environment ─────────────────────────────────────────────────────────
# Template only — copy to .env.local and fill in. .env.local is gitignored;
# never put real values in this file.

# AI model provider (the agent uses Mistral first, then Google Gemini).
# Set at least ONE of these.
MISTRAL_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model id. Defaults to ministral-8b-latest (Mistral)
# or gemini-2.0-flash (Google).
ASTRAX_MODEL=ministral-8b-latest

# Arc network a first-time visitor lands on: mainnet | testnet. Defaults to
# testnet when unset. Users switch at any time with the network switcher.
#   Arc Mainnet: chain id 5042,    real USDC
#   Arc Testnet: chain id 5042002, free test USDC from https://faucet.circle.com
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# Public URL of the site, used for link previews (Open Graph / X cards). On Vercel the
# production domain is detected automatically, so this is only needed elsewhere.
NEXT_PUBLIC_SITE_URL=

# Optional: your own RPC endpoints (comma-separated, full URLs including your key, e.g.
# https://arc-mainnet.infura.io/v3/<key> or your QuickNode URL). They are tried first;
# if one fails Astrax moves straight on to the next, then to Circle's public endpoint
# and its partners' keyless endpoints (Blockdaemon, dRPC, QuickNode). These values reach
# the browser, so restrict the key to your domain in the provider's dashboard.
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=

# Optional: WalletConnect / Reown project id (https://cloud.reown.com). Enables
# mobile wallets via QR in the connect modal; browser wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional: a DEX/aggregator identifier to enable on-chain swaps
ARC_DEX=

# Database for contacts, scheduled payments, payment links and assets.
# Leave empty locally: a file at .data/astrax.db is used automatically.
# REQUIRED on Vercel (no persistent disk): create a free Turso database
#   turso db create astrax && turso db show astrax --url && turso db tokens create astrax
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Scheduled payments: secret used to encrypt stored keys at rest (set a long random string)
SCHEDULER_ENC_KEY=

# Signs wallet-ownership session cookies (who may view/cancel payment links and
# schedules). Required in production; set a long random string.
AUTH_SECRET=

# Scheduled payments: secret the hourly Vercel crons must present in production
# (Vercel sends it automatically). At least 32 characters, or the endpoint refuses.
CRON_SECRET=

# Optional: Pinata, for IPFS file uploads and NFT metadata. Server-only — do NOT
# prefix with NEXT_PUBLIC_ (that would ship the key to every browser).
PINATA_JWT=
# Dedicated gateway domain, no https:// (app.pinata.cloud → Gateways),
# e.g. your-subdomain.mypinata.cloud. Falls back to ipfs.io if unset.
PINATA_GATEWAY=

# Optional: Gemini key for the generateImage tool (/api/generate-image).
# The generateDiagram tool (mermaid) works without this.
NEXT_PUBLIC_GEMINI_KEY=
